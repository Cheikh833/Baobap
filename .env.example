# Chaîne de connexion PostgreSQL
DATABASE_URL="postgresql://baobab:baobab@localhost:5432/baobab"
# Secret utilisé pour signer les jetons CSRF / sessions (32+ caractères aléatoires)
SESSION_SECRET="change-me-with-a-long-random-string"
# Mettre à "true" en production (cookies Secure)
COOKIE_SECURE="false"
# URL publique de l'application (utilisée pour les URL de retour et de notification des paiements)
APP_URL="http://localhost:3000"
# Paiement en ligne CinetPay (Wave, Orange Money, MTN, Moov, cartes). Laisser vide pour désactiver.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
# Clé secrète (vérification HMAC de l'en-tête x-token des notifications) — fortement recommandée.
CINETPAY_SECRET_KEY=""
# Connexion avec Google (OpenID Connect). Laisser vide pour masquer le bouton. Voir docs/deploiement.md.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Connexion avec Microsoft (comptes Outlook / Microsoft 365). Laisser vide pour masquer le bouton.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Connexion avec Apple (compte Apple Developer requis). Laisser vide pour masquer le bouton.
APPLE_CLIENT_ID=""      # identifiant du « Services ID », ex. sn.baobab.web
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""    # contenu du fichier .p8 (les retours à la ligne peuvent être écrits \n)
# BAOBAB AI (assistant). Clé d'API Anthropic (console.anthropic.com). Laisser vide pour désactiver l'assistant.
ANTHROPIC_API_KEY=""
# Modèle utilisé (par défaut claude-opus-5-5). Moins cher : claude-sonnet-5-5 ou claude-haiku-5-5.
BAOBAB_AI_MODEL=""
# Envoi d'emails (invitations, mot de passe oublié) — SMTP : Brevo, Mailjet, Gmail, OVH… Laisser vide pour désactiver.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BAOBAB <no-reply@votre-domaine.sn>"
# Paiement par transfert Wave / Orange Money vers votre numéro (vérifié à la main dans /admin).
PAYMENT_MOBILE_NUMBER=""
PAYMENT_MOBILE_NAME=""
PAYMENT_MOBILE_OPERATORS="Wave,Orange Money"
# Emails des administrateurs de la plateforme (accès à /admin), séparés par des virgules.
PLATFORM_ADMIN_EMAILS=""
