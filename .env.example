# Chaîne de connexion PostgreSQL
DATABASE_URL="postgresql://baobab:baobab@localhost:5432/baobab"
# Secret utilisé pour signer les jetons CSRF / sessions (32+ caractères aléatoires)
SESSION_SECRET="change-me-with-a-long-random-string"
# Mettre à "true" en production (cookies Secure)
COOKIE_SECURE="false"
# URL publique de l'application (utilisée pour les URL de retour et de notification des paiements)
APP_URL="http://localhost:3000"
# Paiement en ligne CinetPay (Wave, Orange Money, MTN, Moov, cartes). Laisser vide pour désactiver.
CINETPAY_API_KEY=""
CINETPAY_SITE_ID=""
# Clé secrète (vérification HMAC de l'en-tête x-token des notifications) — fortement recommandée.
CINETPAY_SECRET_KEY=""
# Envoi d'emails (invitations, mot de passe oublié) — SMTP : Brevo, Mailjet, Gmail, OVH… Laisser vide pour désactiver.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="BAOBAB <no-reply@votre-domaine.sn>"
# Paiement par transfert Wave / Orange Money vers votre numéro (vérifié à la main dans /admin).
PAYMENT_MOBILE_NUMBER=""
PAYMENT_MOBILE_NAME=""
PAYMENT_MOBILE_OPERATORS="Wave,Orange Money"
# Emails des administrateurs de la plateforme (accès à /admin), séparés par des virgules.
PLATFORM_ADMIN_EMAILS=""
