// BAOBAB — schéma relationnel (Phase 1 + tranche Portefeuille → Programme → Projet)
// Le modèle cible complet est documenté dans docs/database/data-model.md.
// Règles : chaque ressource métier appartient à une organisation (organizationId),
// horodatage + auteur de création/modification, soft delete (deletedAt) sur les entités métier.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────── Identité ─────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String? // absent pour un compte créé via Google / Apple (un mot de passe peut être ajouté ensuite)
  jobTitle     String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?
  termsAcceptedAt DateTime? // acceptation des CGU et de la politique de confidentialité

  sessions    Session[]
  memberships Membership[]
  resetTokens PasswordResetToken[]
  oauthAccounts OAuthAccount[]
}

/// Compte externe (Google, Apple) rattaché à un utilisateur : identifiant stable du fournisseur (« sub »).
model OAuthAccount {
  id                String   @id @default(cuid())
  userId            String
  provider          String // "google" | "apple"
  providerAccountId String
  email             String?
  createdAt         DateTime @default(now())
  lastUsedAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id          String   @id // hash SHA-256 du jeton (le jeton brut n'est jamais stocké)
  userId      String
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ───────────── Organisation ─────────────

enum OrganizationType {
  NGO_NATIONAL
  NGO_INTERNATIONAL
  ASSOCIATION
  FOUNDATION
  COMMUNITY
  PUBLIC_INSTITUTION
  MINISTRY
  LOCAL_GOVERNMENT
  DEVELOPMENT_AGENCY
  UN_AGENCY
  INTERNATIONAL_ORGANIZATION
  DONOR
  CONSULTING
  COMPANY
  RESEARCH
  OTHER
}

// ───────────── Abonnement ─────────────
// Catalogue des plans et limites : src/lib/plans.ts. Règles : docs/product/tarification.md.

enum PlanCode {
  ESSENTIEL
  PROFESSIONNEL
  INSTITUTION
  ENTREPRISE
}

enum SubscriptionStatus {
  TRIALING // essai gratuit en cours
  ACTIVE // abonnement payé
  PAST_DUE // paiement en retard (période de grâce)
  CANCELED // résilié
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model Organization {
  id           String           @id @default(cuid())
  name         String
  shortName    String?
  code         String           @unique
  type         OrganizationType @default(OTHER)
  description  String?
  country      String
  region       String?
  city         String?
  address      String?
  phone        String?
  email        String?
  website      String?
  foundedYear  Int?
  sectors      String[]
  mission      String?
  vision       String?
  values       String?
  size         String?
  defaultCurrency String        @default("XOF")
  isDemo          Boolean       @default(false) // espace de démonstration (données fictives)
  plan               PlanCode           @default(PROFESSIONNEL)
  subscriptionStatus SubscriptionStatus @default(TRIALING)
  billingCycle       BillingCycle       @default(MONTHLY)
  trialEndsAt        DateTime?
  currentPeriodEnd   DateTime? // fin de la période payée
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  createdById  String?

  memberships Membership[]
  roles       Role[]
  units       OrganizationalUnit[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  portfolios  Portfolio[]
  programs    Program[]
  projects    Project[]
  planRequests PlanRequest[]
  payments     Payment[]
  strategicPlans StrategicPlan[]
}

enum UnitType {
  DIRECTORATE
  DEPARTMENT
  SERVICE
  UNIT
  BRANCH
  REGIONAL_OFFICE
  TEAM
  PROJECT_CELL
}

model OrganizationalUnit {
  id             String    @id @default(cuid())
  organizationId String
  parentId       String?
  name           String
  code           String?
  type           UnitType
  description    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       OrganizationalUnit?  @relation("UnitTree", fields: [parentId], references: [id])
  children     OrganizationalUnit[] @relation("UnitTree")
  members      UnitMembership[]

  @@index([organizationId])
}

// Rôle configurable par organisation. Les rôles système sont créés à la création de l'organisation.
model Role {
  id             String   @id @default(cuid())
  organizationId String
  key            String // ex. ORG_OWNER, PROJECT_MANAGER
  name           String
  description    String?
  permissions    String[] // codes "ressource:action" (src/server/permissions/catalog.ts)
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  invitations  Invitation[]

  @@unique([organizationId, key])
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model Membership {
  id             String           @id @default(cuid())
  userId         String
  organizationId String
  roleId         String
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role             @relation(fields: [roleId], references: [id])
  units        UnitMembership[]

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model UnitMembership {
  membershipId String
  unitId       String
  position     String?

  membership Membership         @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  unit       OrganizationalUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@id([membershipId, unitId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED
}

model Invitation {
  id             String           @id @default(cuid())
  organizationId String
  email          String
  roleId         String
  tokenHash      String           @unique
  status         InvitationStatus @default(PENDING)
  invitedById    String
  expiresAt      DateTime
  createdAt      DateTime         @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@index([organizationId, email])
}

// ───────────── Audit ─────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  actorId        String?
  action         String // ex. project.create
  entityType     String
  entityId       String?
  summary        String
  changes        Json?
  ip             String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

// ───────────── Portefeuilles / Programmes / Projets ─────────────

enum LifecycleStatus {
  DRAFT
  PREPARATION
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

model Portfolio {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  code           String
  description    String?
  objective      String?
  managerId      String? // User.id (membre de l'organisation)
  startDate      DateTime?
  endDate        DateTime?
  plannedBudget  Decimal?        @db.Decimal(18, 2)
  currency       String          @default("XOF")
  status         LifecycleStatus @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  programs     Program[]
  projects     Project[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Program {
  id               String          @id @default(cuid())
  organizationId   String
  portfolioId      String?
  name             String
  code             String
  managerId        String?
  coordinatorId    String?
  sectors          String[]
  zones            String[]
  context          String?
  problemStatement String?
  generalObjective String?
  startDate        DateTime?
  endDate          DateTime?
  plannedBudget    Decimal?        @db.Decimal(18, 2)
  currency         String          @default("XOF")
  status           LifecycleStatus @default(DRAFT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolio    Portfolio?   @relation(fields: [portfolioId], references: [id])
  projects     Project[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([portfolioId])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Project {
  id               String          @id @default(cuid())
  organizationId   String
  portfolioId      String?
  programId        String?
  name             String
  code             String
  shortDescription String?
  type             String?
  sectors          String[]
  managerId        String? // chef de projet
  priority         Priority        @default(MEDIUM)
  sdgs             Int[] // ODD 1–17
  context          String?
  problemStatement String?
  justification    String?
  generalObjective String?
  specificObjectives String[]
  country          String?
  region           String?
  zones            String[]
  directBeneficiaries   Int?
  indirectBeneficiaries Int?
  startDate        DateTime?
  endDate          DateTime?
  plannedBudget    Decimal?        @db.Decimal(18, 2)
  currency         String          @default("XOF")
  status           LifecycleStatus @default(DRAFT)
  wizardStep       Int             @default(1) // reprise du brouillon
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  portfolio    Portfolio?   @relation(fields: [portfolioId], references: [id])
  program      Program?     @relation(fields: [programId], references: [id])
  objectiveContributions ProjectObjectiveContribution[]
  phases       ProjectPhase[]
  activities   Activity[]
  tasks        Task[]
  milestones   Milestone[]
  logframe     LogframeItem[]
  indicators   Indicator[]
  datasets     Dataset[]
  fundings     Funding[]
  budgetLines  BudgetLine[]
  expenses     Expense[]
  risks        Risk[]
  team         ProjectMember[]
  documents    Document[]
  knowledge    KnowledgeArticle[]
  reports      Report[]
  stakeholders Stakeholder[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([programId])
  @@index([portfolioId])
}

// Demande d'activation / changement de plan, traitée par l'équipe BAOBAB (scripts/billing.ts)
// tant que le paiement en ligne n'est pas intégré.
enum PlanRequestStatus {
  PENDING
  DONE
  CANCELED
}

model PlanRequest {
  id             String            @id @default(cuid())
  organizationId String
  plan           PlanCode
  cycle          BillingCycle
  solidarity     Boolean           @default(false) // tarif solidaire demandé (justificatif à fournir)
  contactPhone   String?
  message        String?
  status         PlanRequestStatus @default(PENDING)
  requestedById  String
  createdAt      DateTime          @default(now())
  processedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

// Paiement en ligne d'un abonnement (CinetPay : Wave, Orange Money, MTN, Moov, cartes).
// Le statut n'est JAMAIS déduit de la notification seule : il est confirmé par l'API de vérification.
enum PaymentStatus {
  PENDING
  ACCEPTED
  REFUSED
  CANCELED
}

model Payment {
  id             String        @id @default(cuid())
  organizationId String
  provider       String        @default("cinetpay")
  transactionId  String        @unique // identifiant transmis au prestataire
  plan           PlanCode
  cycle          BillingCycle
  amountXof      Int
  currency       String        @default("XOF")
  status         PaymentStatus @default(PENDING)
  paymentUrl     String?
  paymentMethod  String? // ex. WAVECI, OMSN, cartes…
  externalReference String? // paiement manuel : identifiant de la transaction Wave / Orange Money
  senderPhone    String? // paiement manuel : numéro ayant envoyé l'argent
  reviewedById   String? // administrateur plateforme ayant confirmé ou rejeté
  providerData   Json?
  requestedById  String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  paidAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([provider, status])
}

// Réinitialisation du mot de passe : jeton à usage unique, haché, valable 1 heure.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────── Stratégie (phase 2) ─────────────
// Plan stratégique → Axes → Objectifs stratégiques ; les projets y contribuent (plusieurs-à-plusieurs, pondéré).

model StrategicPlan {
  id             String          @id @default(cuid())
  organizationId String
  title          String
  reference      String?
  startDate      DateTime?
  endDate        DateTime?
  context        String?
  vision         String?
  mission        String?
  status         LifecycleStatus @default(DRAFT)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  createdById    String?
  updatedById    String?
  deletedAt      DateTime?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  axes         StrategicAxis[]

  @@index([organizationId, status])
}

model StrategicAxis {
  id             String    @id @default(cuid())
  organizationId String
  planId         String
  code           String
  title          String
  description    String?
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  plan       StrategicPlan        @relation(fields: [planId], references: [id], onDelete: Cascade)
  objectives StrategicObjective[]

  @@index([planId])
}

model StrategicObjective {
  id             String    @id @default(cuid())
  organizationId String
  axisId         String
  code           String
  title          String
  description    String?
  expectedResult String?
  ownerId        String? // responsable (membre de l'organisation)
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  axis          StrategicAxis                  @relation(fields: [axisId], references: [id], onDelete: Cascade)
  contributions ProjectObjectiveContribution[]

  @@index([axisId])
  @@index([organizationId])
}

/// Contribution d'un projet à un objectif stratégique. `weight` = part (%) du projet affectée à l'objectif :
/// la somme des poids d'un projet ne dépasse jamais 100 %, ce qui évite les doubles comptages budgétaires.
model ProjectObjectiveContribution {
  projectId   String
  objectiveId String
  weight      Int      @default(100)
  note        String?
  createdAt   DateTime @default(now())

  project   Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  objective StrategicObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@id([projectId, objectiveId])
  @@index([objectiveId])
}

// ───────────── Planification (phase 3) ─────────────
// Projet → Phases (facultatives) → Activités → Tâches ; jalons ; dépendances entre activités.

enum ActivityStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

model ProjectPhase {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  position       Int       @default(0)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activities Activity[]

  @@index([projectId])
}

model Activity {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  phaseId        String?
  code           String
  title          String
  description    String?
  ownerId        String?
  startDate      DateTime?
  endDate        DateTime?
  status         ActivityStatus @default(NOT_STARTED)
  progress       Int            @default(0) // avancement saisi (utilisé seulement si l'activité n'a pas de tâches)
  position       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  deletedAt      DateTime?

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase        ProjectPhase?        @relation(fields: [phaseId], references: [id])
  tasks        Task[]
  predecessors ActivityDependency[] @relation("successor")
  successors   ActivityDependency[] @relation("predecessor")

  @@index([projectId])
  @@index([organizationId, endDate])
}

/// Dépendance « fin → début » : l'activité successeur ne devrait pas commencer avant la fin du prédécesseur.
model ActivityDependency {
  predecessorId String
  successorId   String

  predecessor Activity @relation("predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Activity @relation("successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@id([predecessorId, successorId])
}

model Task {
  id             String     @id @default(cuid())
  organizationId String
  projectId      String
  activityId     String?
  title          String
  description    String?
  assigneeId     String?
  dueDate        DateTime?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  position       Int        @default(0)
  completedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdById    String?
  deletedAt      DateTime?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  activity Activity? @relation(fields: [activityId], references: [id])

  @@index([projectId, status])
  @@index([organizationId, assigneeId, status])
}

model Milestone {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String
  title          String
  dueDate        DateTime
  achievedAt     DateTime?
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

// ───────────── Suivi-évaluation / MEAL (phase 4) ─────────────

enum ResultLevel {
  IMPACT
  OUTCOME
  OUTPUT
  ACTIVITY
}

/// Élément du cadre logique : Impact → Effets (outcomes) → Extrants (outputs) → Activités.
model LogframeItem {
  id             String      @id @default(cuid())
  organizationId String
  projectId      String
  parentId       String?
  level          ResultLevel
  code           String
  title          String
  description    String?
  assumptions    String? // hypothèses / conditions de réussite
  position       Int         @default(0)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  deletedAt      DateTime?

  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent     LogframeItem?  @relation("LogframeTree", fields: [parentId], references: [id])
  children   LogframeItem[] @relation("LogframeTree")
  indicators Indicator[]

  @@index([projectId])
}

enum IndicatorType {
  QUANTITATIVE
  QUALITATIVE
}

enum IndicatorDirection {
  INCREASE // une valeur plus élevée est meilleure
  DECREASE // une valeur plus basse est meilleure
}

enum IndicatorAggregation {
  LATEST // la valeur actuelle est la dernière valeur validée (taux, nombre cumulé déclaré…)
  SUM // la valeur actuelle est la somme des valeurs validées des périodes
}

enum ReportingFrequency {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  ONE_TIME
}

model Indicator {
  id             String               @id @default(cuid())
  organizationId String
  projectId      String
  logframeItemId String?
  code           String
  name           String
  definition     String
  unit           String
  type           IndicatorType        @default(QUANTITATIVE)
  direction      IndicatorDirection   @default(INCREASE)
  aggregation    IndicatorAggregation @default(LATEST)
  baseline       Decimal?             @db.Decimal(18, 4)
  baselineDate   DateTime?
  target         Decimal?             @db.Decimal(18, 4)
  targetDate     DateTime?
  frequency      ReportingFrequency   @default(QUARTERLY)
  source         String? // source de vérification
  method         String? // méthode de collecte
  responsibleId  String?
  disaggregations String[] // ex. ["Sexe", "Tranche d'âge"]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  createdById    String?
  deletedAt      DateTime?

  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  logframeItem LogframeItem?    @relation(fields: [logframeItemId], references: [id])
  values       IndicatorValue[]

  @@index([projectId])
  @@index([organizationId])
}

enum ValueStatus {
  DRAFT
  VALIDATED
  REJECTED
}

/// Valeur d'un indicateur pour une période. Une valeur validée n'est jamais modifiée :
/// une correction crée une nouvelle valeur qui la remplace (supersedesId), l'ancienne reste tracée.
model IndicatorValue {
  id             String      @id @default(cuid())
  organizationId String
  indicatorId    String
  periodStart    DateTime
  periodEnd      DateTime
  value          Decimal?    @db.Decimal(18, 4)
  textValue      String? // indicateurs qualitatifs
  disaggregation Json? // { "Sexe": { "Femmes": 120, "Hommes": 80 } }
  source         String
  comment        String?
  status         ValueStatus @default(DRAFT)
  supersedesId   String?     @unique
  collectedById  String
  validatedById  String?
  validatedAt    DateTime?
  reviewComment  String?
  createdAt      DateTime    @default(now())

  indicator    Indicator       @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  supersedes   IndicatorValue? @relation("Correction", fields: [supersedesId], references: [id])
  supersededBy IndicatorValue? @relation("Correction")

  @@index([indicatorId, periodEnd])
}

/// Jeu de données importé (CSV). Les cellules d'origine sont conservées telles quelles ;
/// les types de colonnes sont inférés, et peuvent être corrigés (columnTypes) sans toucher aux données.
model Dataset {
  id             String    @id @default(cuid())
  organizationId String
  projectId      String?
  name           String
  description    String?
  fileName       String
  delimiter      String
  headers        String[]
  rows           Json // string[][]
  rowCount       Int
  columnCount    Int
  columnTypes    Json      @default("{}") // { [colonne]: "number" | "date" | "categorical" | "text" }
  createdById    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  project Project? @relation(fields: [projectId], references: [id])

  @@index([organizationId])
  @@index([projectId])
}

// ───────────── Finances (phase 5) ─────────────
// Tous les montants d'un projet sont dans la devise du projet : aucune conversion implicite.

/// Financement (convention avec un bailleur ou fonds propres) d'un projet.
model Funding {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  donor          String
  reference      String?
  amount         Decimal      @db.Decimal(18, 2)
  startDate      DateTime?
  endDate        DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLines BudgetLine[]

  @@index([projectId])
  @@index([organizationId])
}

enum BudgetCategory {
  HR
  TRAVEL
  EQUIPMENT
  SUPPLIES
  SERVICES
  ACTIVITIES
  OPERATING
  INDIRECT
  OTHER
}

model BudgetLine {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  fundingId      String?
  code           String
  label          String
  category       BudgetCategory @default(ACTIVITIES)
  plannedAmount  Decimal        @db.Decimal(18, 2)
  notes          String?
  position       Int            @default(0)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  funding  Funding?  @relation(fields: [fundingId], references: [id])
  expenses Expense[]

  @@index([projectId])
  @@index([organizationId])
}

enum ExpenseStatus {
  DRAFT
  VALIDATED
  REJECTED
  CANCELED
}

/// Dépense. Saisie en brouillon ; validée par une autre personne ; une dépense validée ne se modifie pas
/// (elle peut seulement être annulée, avec motif, ce qui reste tracé).
model Expense {
  id             String        @id @default(cuid())
  organizationId String
  projectId      String
  budgetLineId   String
  date           DateTime
  amount         Decimal       @db.Decimal(18, 2)
  description    String
  supplier       String?
  reference      String? // n° de pièce justificative
  status         ExpenseStatus @default(DRAFT)
  createdById    String?
  validatedById  String?
  validatedAt    DateTime?
  reviewComment  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id])

  @@index([projectId])
  @@index([organizationId, status])
}

// ───────────── Risques (phase 5) ─────────────

enum RiskCategory {
  STRATEGIC
  OPERATIONAL
  FINANCIAL
  SECURITY
  COMPLIANCE
  REPUTATION
  ENVIRONMENTAL
  OTHER
}

enum RiskStatus {
  OPEN
  MITIGATING
  CLOSED
}

model Risk {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String
  code           String
  title          String
  description    String?
  category       RiskCategory @default(OPERATIONAL)
  probability    Int // 1 à 5
  impact         Int // 1 à 5
  ownerId        String?
  mitigation     String?
  contingency    String?
  status         RiskStatus   @default(OPEN)
  reviewDate     DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
}

// ───────────── Équipe projet et parties prenantes ─────────────

/// Membre de l'organisation affecté à un projet.
model ProjectMember {
  id         String    @id @default(cuid())
  organizationId String
  projectId  String
  userId     String
  role       String // rôle dans le projet (ex. « Coordinatrice terrain »)
  allocation Int? // taux d'affectation en %
  startDate  DateTime?
  endDate    DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([organizationId])
}

enum StakeholderType {
  DONOR
  GOVERNMENT
  LOCAL_AUTHORITY
  COMMUNITY
  BENEFICIARY
  PARTNER
  PRIVATE
  MEDIA
  OTHER
}

/// Partie prenante externe. Influence et intérêt de 1 (faible) à 3 (fort) : grille de Mendelow.
model Stakeholder {
  id             String          @id @default(cuid())
  organizationId String
  projectId      String
  name           String
  type           StakeholderType @default(PARTNER)
  organization   String?
  influence      Int
  interest       Int
  contactName    String?
  email          String?
  phone          String?
  engagement     String? // stratégie d'implication / communication
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt      DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
}

// ───────────── Documents & connaissances (phase 6) ─────────────

enum DocumentCategory {
  REPORT
  CONTRACT
  AGREEMENT
  TERMS_OF_REFERENCE
  MINUTES
  PROCEDURE
  DATA
  PHOTO
  OTHER
}

model Document {
  id             String           @id @default(cuid())
  organizationId String
  projectId      String?
  title          String
  description    String?
  category       DocumentCategory @default(OTHER)
  tags           String[]
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?

  project  Project?          @relation(fields: [projectId], references: [id])
  versions DocumentVersion[]

  @@index([organizationId])
  @@index([projectId])
}

/// Version d'un document. Le fichier est conservé tel quel (empreinte SHA-256) ; le texte extrait sert à la recherche.
model DocumentVersion {
  id             String   @id @default(cuid())
  organizationId String
  documentId     String
  version        Int
  fileName       String
  mimeType       String
  size           Int
  sha256         String
  content        Bytes
  text           String?
  comment        String?
  createdById    String?
  createdAt      DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([organizationId])
}

enum KnowledgeCategory {
  LESSON
  PROCEDURE
  GUIDE
  FAQ
  OTHER
}

/// Fiche de connaissance : leçon apprise, procédure, guide.
model KnowledgeArticle {
  id             String            @id @default(cuid())
  organizationId String
  projectId      String?
  title          String
  category       KnowledgeCategory @default(LESSON)
  body           String
  tags           String[]
  published      Boolean           @default(true)
  authorId       String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  project Project? @relation(fields: [projectId], references: [id])

  @@index([organizationId])
}

// ───────────── BAOBAB Studio (phase 9) ─────────────

enum ReportType {
  PROJECT_PROGRESS
  PROJECT_FINANCIAL
  ORGANIZATION_SUMMARY
}

enum ReportStatus {
  DRAFT
  FINAL
}

/// Rapport généré depuis les données. À la validation, les chiffres sont figés (snapshot) : le rapport final
/// ne change plus, même si les données évoluent ensuite.
model Report {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  type           ReportType
  title          String
  periodStart    DateTime?
  periodEnd      DateTime?
  narrative      Json         @default("{}") // { résumé, faits marquants, difficultés, perspectives }
  status         ReportStatus @default(DRAFT)
  snapshot       Json? // données figées à la validation
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  project Project? @relation(fields: [projectId], references: [id])

  @@index([organizationId])
  @@index([projectId])
}

// ───────────── BAOBAB AI (phase 8) ─────────────

/// Conversation privée d'un utilisateur avec l'assistant.
model AiConversation {
  id             String      @id @default(cuid())
  organizationId String
  userId         String
  title          String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  messages AiMessage[]

  @@index([organizationId, userId])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  organizationId String
  role           String // "user" | "assistant"
  content        String
  sources        Json? // [{ label, href }]
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime       @default(now())

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}
