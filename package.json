{
  "name": "baobab",
  "version": "0.1.0",
  "description": "BAOBAB — plateforme SaaS de pilotage des organisations, portefeuilles, programmes, projets et impacts.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "billing": "tsx scripts/billing.ts",
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/check-env.mjs && prisma migrate deploy && next build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cheikh833/Baobap.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Cheikh833/Baobap/issues"
  },
  "homepage": "https://github.com/Cheikh833/Baobap#readme",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "next": "^15.5.28",
    "nodemailer": "^6.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "private": true,
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
